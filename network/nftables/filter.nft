chain prerouting {
  type filter hook prerouting priority filter; policy accept;

  # NOTE: rpf needs to be after fw marking in mangle, otherwise policy based routing breaks
  fib saddr . mark . iif oif eq 0 counter drop comment "strict reverse path filter"
}

chain input {
  type filter hook input priority filter; policy drop;

  # stateless rules
  iif "lo" accept
  iifname $wan_iface ip6 saddr $transix_endpoints ip6 nexthdr ipv4 accept

  # conntrack
  ct state { established, related } accept
  ct state invalid counter drop

  # zone based stateful rules
  iifname $zone_lan_ifaces counter jump input_lan
  iifname $zone_wan_ifaces counter jump input_wan
  iifname $zone_wg0_ifaces counter jump input_wg0
  iifname $zone_wg1_ifaces counter jump input_wg1

  counter reject
}

# zone: lan -> router
chain input_lan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  udp dport 53 accept comment "allow dns over udp"
  tcp dport 53 tcp flags syn / fin,syn,rst,ack accept comment "allow dns over tcp"

  udp sport 68 udp dport 67 accept comment "allow dhcp"

  tcp dport 22 tcp flags syn / fin,syn,rst,ack accept comment "allow ssh"

  udp dport 55240 accept comment "allow wireguard wg0"
  udp dport 55241 accept comment "allow wireguard wg1"

  counter reject
}

# zone: wan -> router
chain input_wan {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply, nd-router-solicit, nd-router-advert } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, nd-neighbor-solicit . 0, nd-neighbor-advert . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  ip6 saddr fe80::/10 ip6 daddr fe80::/10 udp sport 547 udp dport 546 counter accept comment "allow dhcpv6 from server"

  udp dport 55240 accept comment "allow wireguard wg0"
  udp dport 55241 accept comment "allow wireguard wg1"

  counter drop
}

# zone: wg0 -> router
chain input_wg0 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  udp dport 53 accept comment "allow dns over udp"
  tcp dport 53 tcp flags syn / fin,syn,rst,ack accept comment "allow dns over tcp"

  tcp dport 22 tcp flags syn / fin,syn,rst,ack accept comment "allow ssh"

  counter reject
}

# zone: wg1 -> router
chain input_wg1 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  udp dport 53 accept comment "allow dns over udp"
  tcp dport 53 tcp flags syn / fin,syn,rst,ack accept comment "allow dns over tcp"

  tcp dport 22 tcp flags syn / fin,syn,rst,ack accept comment "allow ssh"

  counter reject
}

chain fastpath {
  meta l4proto tcp flow add @fastpath counter
  meta l4proto udp flow add @fastpath counter
  return
}

chain forward {
  type filter hook forward priority filter; policy drop;

  # offload some established connections
  ct state established jump fastpath

  # conntrack
  ct state { established, related } accept
  ct state invalid counter drop

  # zone based stateful rules
  # from lan
  iifname $zone_lan_ifaces oifname $zone_wan_ifaces counter jump forward_lan_wan
  iifname $zone_lan_ifaces oifname $zone_wg0_ifaces counter jump forward_lan_wg0
  iifname $zone_lan_ifaces oifname $zone_wg1_ifaces counter jump forward_lan_wg1
  iifname $zone_lan_ifaces oifname $zone_lan_ifaces counter accept # allow intra zone
  # from wan
  iifname $zone_wan_ifaces oifname $zone_lan_ifaces counter jump forward_wan_lan
  iifname $zone_wan_ifaces oifname $zone_wg0_ifaces counter jump forward_wan_wg0
  iifname $zone_wan_ifaces oifname $zone_wg1_ifaces counter jump forward_wan_wg1
  iifname $zone_wan_ifaces oifname $zone_wan_ifaces counter drop # disallow intra zone
  # from wg0
  iifname $zone_wg0_ifaces oifname $zone_lan_ifaces counter jump forward_wg0_lan
  iifname $zone_wg0_ifaces oifname $zone_wan_ifaces counter jump forward_wg0_wan
  iifname $zone_wg0_ifaces oifname $zone_wg1_ifaces counter jump forward_wg0_wg1
  iifname $zone_wg0_ifaces oifname $zone_wg0_ifaces counter reject # disallow intra zone
  # from wg1
  iifname $zone_wg1_ifaces oifname $zone_lan_ifaces counter jump forward_wg1_lan
  iifname $zone_wg1_ifaces oifname $zone_wan_ifaces counter jump forward_wg1_wan
  iifname $zone_wg1_ifaces oifname $zone_wg0_ifaces counter jump forward_wg1_wg0
  iifname $zone_wg1_ifaces oifname $zone_wg1_ifaces counter reject # disallow intra zone

  counter reject
}

# zone: lan -> wan
chain forward_lan_wan {
  tcp flags syn tcp option maxseg size set rt mtu counter comment "tcp mss clamping"

  # block transix tunnel from lan as it can be used to bypass firewall
  # use meta l4proto instead of ip6 nexthdr so extension headers can't be used to bypass this rule
  ip6 daddr $transix_endpoints meta l4proto ipv4 drop

  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: lan -> wg0
chain forward_lan_wg0 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: lan -> wg1
chain forward_lan_wg1 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: wan -> lan
chain forward_wan_lan {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  counter drop
}

# zone: wan -> wg0
chain forward_wan_wg0 {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  counter drop
}

# zone: wan -> wg1
chain forward_wan_wg1 {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  counter drop
}

# zone: wg0 -> lan
chain forward_wg0_lan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  # TODO: only allow what's needed
  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: wg0 -> wan
chain forward_wg0_wan {
  counter drop
}

# zone: wg0 -> wg1
chain forward_wg0_wg1 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: wg1 -> lan
chain forward_wg1_lan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: wg1 -> wan
chain forward_wg1_wan {
  tcp flags syn tcp option maxseg size set rt mtu counter comment "tcp mss clamping"

  # block transix tunnel from lan as it can be used to bypass firewall
  # use meta l4proto instead of ip6 nexthdr so extension headers can't be used to bypass this rule
  ip6 daddr $transix_endpoints meta l4proto ipv4 drop

  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: wg1 -> wg0
chain forward_wg1_wg0 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

chain output {
  type filter hook output priority filter; policy accept;

  # stateless rules
  oif "lo" accept
  oifname $wan_iface ip6 daddr $transix_endpoints ip6 nexthdr ipv4 accept

  # conntrack
  ct state { established, related } accept
  ct state invalid counter drop

  # zone based stateful rules
  oifname $zone_wan_ifaces counter jump output_wan
  oifname $zone_lan_ifaces counter jump output_lan
  oifname $zone_wg0_ifaces counter jump output_wg0
  oifname $zone_wg1_ifaces counter jump output_wg1

  counter reject
}

# zone: router -> wan
chain output_wan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  tcp sport $self_ephemeral_port_range tcp flags syn / fin,syn,rst,ack counter accept
  udp sport $self_ephemeral_port_range counter accept

  ip6 saddr fe80::/10 udp sport 546 udp dport 547 counter accept comment "allow dhcpv6 to server"

  counter reject
}

# zone: router -> lan
chain output_lan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  tcp sport $self_ephemeral_port_range tcp flags syn / fin,syn,rst,ack counter accept
  udp sport $self_ephemeral_port_range counter accept

  counter reject
}

# zone: router -> wg0
chain output_wg0 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  tcp sport $self_ephemeral_port_range tcp flags syn / fin,syn,rst,ack counter accept
  udp sport $self_ephemeral_port_range counter accept

  counter reject
}

# zone: router -> wg1
chain output_wg1 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  tcp sport $self_ephemeral_port_range tcp flags syn / fin,syn,rst,ack counter accept
  udp sport $self_ephemeral_port_range counter accept

  counter reject
}
