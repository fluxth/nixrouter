chain prerouting {
  type filter hook prerouting priority raw; policy accept;

  iif "lo" notrack
  iifname $wan_iface ip6 saddr $transix_endpoints ip6 nexthdr ipv4 notrack

  # upstream filtering inbound
  iifname $wan_iface jump upstream_recv_ipoe
  iifname $transix_iface jump upstream_recv_dslite
  iifname $pppoe_iface jump upstream_recv_pppoe
}

chain postrouting {
  type filter hook postrouting priority raw; policy accept;

  # upstream filtering outbound
  oifname $wan_iface jump upstream_send_ipoe
  oifname $transix_iface jump upstream_send_dslite
  oifname $pppoe_iface jump upstream_send_pppoe
}

chain output {
  type filter hook output priority raw; policy accept;

  oif "lo" notrack
  oifname $wan_iface ip6 daddr $transix_endpoints ip6 nexthdr ipv4 notrack
}

chain upstream_send_ipoe {
  meta nfproto != ipv6 counter drop

  ip6 saddr != @ipv6_linklocal ip6 saddr @ipv6_bogons counter drop
  ip6 daddr != @ipv6_linklocal ip6 daddr @ipv6_bogons counter drop

  accept
}

chain upstream_send_dslite {
  meta nfproto != ipv4 counter drop

  # outbound saddr can include private and dslite B4 address
  ip saddr != @ipv4_private ip saddr != 192.0.0.2 ip saddr @ipv4_bogons counter drop
  # outbound daddr can include dslite AFTR address
  ip daddr != 192.0.0.1 ip daddr @ipv4_bogons counter drop

  accept
}

chain upstream_send_pppoe {
  meta nfproto != ipv4 counter drop

  ip saddr @ipv4_bogons counter drop
  ip daddr @ipv4_bogons counter drop

  accept
}

chain upstream_recv_ipoe {
  meta nfproto != ipv6 counter drop

  ip6 saddr != @ipv6_linklocal ip6 saddr @ipv6_bogons counter drop
  ip6 daddr != @ipv6_linklocal ip6 daddr @ipv6_bogons counter drop

  accept
}

chain upstream_recv_dslite {
  meta nfproto != ipv4 counter drop

  # inbound saddr can include dslite AFTR address
  ip saddr != 192.0.0.1 ip saddr @ipv4_bogons counter drop
  # inbound daddr can include private and dslite B4 address
  ip daddr != @ipv4_private ip daddr != 192.0.0.2 ip daddr @ipv4_bogons counter drop

  accept
}

chain upstream_recv_pppoe {
  meta nfproto != ipv4 counter drop

  ip saddr @ipv4_bogons counter drop
  ip daddr @ipv4_bogons counter drop

  accept
}
