chain fastpath {
  meta l4proto tcp flow add @fastpath counter
  meta l4proto udp flow add @fastpath counter
  return
}

chain forward {
  type filter hook forward priority filter; policy drop;

  # offload some established connections
  ct state established jump fastpath

  # conntrack
  ct state { established, related } accept
  ct state invalid counter drop

  # zone based stateful rules
  # from lan
  iifname $zone_lan_ifaces oifname $zone_wan_ifaces counter jump forward_lan_wan
  iifname $zone_lan_ifaces oifname $zone_wg0_ifaces counter jump forward_lan_wg0
  iifname $zone_lan_ifaces oifname $zone_wg1_ifaces counter jump forward_lan_wg1
  iifname $zone_lan_ifaces oifname $zone_nat64_ifaces counter jump forward_lan_nat64
  iifname $zone_lan_ifaces oifname $zone_lan_ifaces counter accept # allow intra zone
  # from wan
  iifname $zone_wan_ifaces oifname $zone_lan_ifaces counter jump forward_wan_lan
  iifname $zone_wan_ifaces oifname $zone_wg0_ifaces counter jump forward_wan_wg0
  iifname $zone_wan_ifaces oifname $zone_wg1_ifaces counter jump forward_wan_wg1
  iifname $zone_wan_ifaces oifname $zone_wan_ifaces counter drop # disallow intra zone
  # from wg0
  iifname $zone_wg0_ifaces oifname $zone_lan_ifaces counter jump forward_wg0_lan
  iifname $zone_wg0_ifaces oifname $zone_wan_ifaces counter jump forward_wg0_wan
  iifname $zone_wg0_ifaces oifname $zone_wg1_ifaces counter jump forward_wg0_wg1
  iifname $zone_wg0_ifaces oifname $zone_wg0_ifaces counter reject # disallow intra zone
  # from wg1
  iifname $zone_wg1_ifaces oifname $zone_lan_ifaces counter jump forward_wg1_lan
  iifname $zone_wg1_ifaces oifname $zone_wan_ifaces counter jump forward_wg1_wan
  iifname $zone_wg1_ifaces oifname $zone_wg0_ifaces counter jump forward_wg1_wg0
  iifname $zone_wg1_ifaces oifname $zone_wg1_ifaces counter reject # disallow intra zone
  # from nat64
  iifname $zone_nat64_ifaces oifname $zone_wan_ifaces counter accept

  counter reject
}

# zone: lan -> wan
chain forward_lan_wan {
  tcp flags syn tcp option maxseg size set rt mtu counter comment "tcp mss clamping"

  # block transix tunnel from lan as it can be used to bypass firewall
  # use meta l4proto instead of ip6 nexthdr so extension headers can't be used to bypass this rule
  ip6 daddr $transix_endpoints meta l4proto ipv4 drop

  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: lan -> wg0
chain forward_lan_wg0 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: lan -> wg1
chain forward_lan_wg1 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: wan -> lan
chain forward_wan_lan {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  counter drop
}

# zone: wan -> wg0
chain forward_wan_wg0 {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  counter drop
}

# zone: wan -> wg1
chain forward_wan_wg1 {
  icmp type echo-request counter accept
  icmpv6 type { destination-unreachable, time-exceeded, echo-request, echo-reply } counter accept
  icmpv6 type . icmpv6 code { packet-too-big . 0, parameter-problem . 0, parameter-problem . 1 } counter accept
  meta l4proto { icmp, ipv6-icmp } counter drop # count the rest

  counter drop
}

# zone: wg0 -> lan
chain forward_wg0_lan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  # TODO: only allow what's needed
  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: wg0 -> wan
chain forward_wg0_wan {
  counter drop
}

# zone: wg0 -> wg1
chain forward_wg0_wg1 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: wg1 -> lan
chain forward_wg1_lan {
  meta l4proto { icmp, ipv6-icmp } counter accept

  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: wg1 -> wan
chain forward_wg1_wan {
  tcp flags syn tcp option maxseg size set rt mtu counter comment "tcp mss clamping"

  # block transix tunnel from lan as it can be used to bypass firewall
  # use meta l4proto instead of ip6 nexthdr so extension headers can't be used to bypass this rule
  ip6 daddr $transix_endpoints meta l4proto ipv4 drop

  # rely on strict rpf for filtering source address
  meta nfproto ipv6 counter accept
  meta nfproto ipv4 counter accept

  counter reject
}

# zone: wg1 -> wg0
chain forward_wg1_wg0 {
  meta l4proto { icmp, ipv6-icmp } counter accept

  counter reject
}

# zone: lan -> nat64
chain forward_lan_nat64 {
  # only the nat64 prefix is routed here (see network/interfaces.nix), be explicit anyway
  # replies and icmp errors come back through the conntrack rules in the forward chain
  ip6 daddr $nat64_prefix counter accept

  counter reject
}
