define transix_iface = "wan4-dslite"
define transix_endpoints = { 2404:8e00::feed:100, 2404:8e00::feed:101, 2404:8e00::feed:102 }

define wan_iface = "enp4s0"
define lan_iface = "enp5s0"
define lan_ipv6_prefix = 2409:10:720:c200::/64
define lan_ipv4_prefix = 172.24.100.0/24

define pppoe_iface = "wan4-pppoe"
define pppoe_ct_mark = 20

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    # stateless rules
    iifname "lo" accept
    iifname $wan_iface ip6 saddr $transix_endpoints ip6 nexthdr ipv4 accept

    # conntrack
    ct state { established, related } accept
    ct state invalid counter drop

    # stateful rules
    meta l4proto { icmp, ipv6-icmp } counter accept
    tcp dport 22 tcp flags syn / fin,syn,rst,ack accept
    iifname $lan_iface udp dport 67 accept
    iifname $lan_iface udp dport 53 accept

    counter
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    # conntrack
    ct state { established, related } accept
    ct state invalid counter drop

    # ds-lite MSS clamping
    oifname $transix_iface meta nfproto ipv4 tcp flags syn tcp option maxseg size set rt mtu counter

    # stateful rules
    iifname $lan_iface ip6 saddr $lan_ipv6_prefix counter accept
    iifname $lan_iface ip saddr $lan_ipv4_prefix counter accept

    counter
  }

  chain output {
    type filter hook output priority filter; policy accept;

    # stateless rules
    oifname "lo" accept
    oifname $wan_iface ip6 daddr $transix_endpoints ip6 nexthdr ipv4 accept

    # conntrack
    ct state { established, related } accept
    ct state invalid counter drop

    # stateful rules
    meta l4proto { icmp, ipv6-icmp } counter accept
    tcp sport 32768-60999 tcp flags syn / fin,syn,rst,ack counter accept
    udp sport 32768-60999 counter accept
    ip6 nexthdr udp udp sport 546 udp dport 547 counter accept comment "allow dhcpv6"

    counter log prefix "output-drop: "
  }
}

table inet raw {
  chain prerouting {
    type filter hook prerouting priority raw; policy accept;

    iifname "lo" notrack
    iifname $wan_iface ip6 saddr $transix_endpoints ip6 nexthdr ipv4 notrack
  }

  chain output {
    type filter hook output priority raw; policy accept;

    oifname "lo" notrack
    oifname $wan_iface ip6 daddr $transix_endpoints ip6 nexthdr ipv4 notrack
  }
}

table inet mangle {
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;

    iifname $pppoe_iface ct state new ct mark set $pppoe_ct_mark counter
  }

  chain output {
    type route hook output priority mangle; policy accept;

    ct mark $pppoe_ct_mark meta mark set ct mark counter
  }
}
