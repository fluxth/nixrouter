# flush and defines are in external file firewall.nix

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    # stateless rules
    iifname "lo" accept
    iifname $wan_iface ip6 saddr $transix_endpoints ip6 nexthdr ipv4 accept

    # conntrack
    ct state { established, related } accept
    ct state invalid counter drop

    # zone based stateful rules
    iifname $zone_lan_ifaces counter jump input_lan
    iifname $zone_wan_ifaces counter jump input_wan

    counter reject
  }

  # zone: lan -> router
  chain input_lan {
    meta l4proto { icmp, ipv6-icmp } counter accept

    udp dport 53 accept comment "allow dns"
    udp sport 68 udp dport 67 accept comment "allow dhcp"

    tcp dport 22 tcp flags syn / fin,syn,rst,ack accept comment "allow ssh"

    counter reject
  }

  # zone: wan -> router
  chain input_wan {
    # TODO: tighten this down
    meta l4proto { icmp, ipv6-icmp } counter jump upstream_recv

    # TODO: temporary until wireguard, do not allow from ipv4 due to frequent port scans
    meta nfproto ipv6 tcp dport 22 tcp flags syn / fin,syn,rst,ack counter jump upstream_recv comment "allow ssh"

    counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    # conntrack
    ct state { established, related } accept
    ct state invalid counter drop

    # zone based stateful rules
    iifname $zone_lan_ifaces oifname $zone_wan_ifaces counter jump forward_lan_wan
    iifname $zone_wan_ifaces oifname $zone_lan_ifaces counter jump forward_wan_lan

    counter reject
  }

  # zone: lan -> wan
  chain forward_lan_wan {
    tcp flags syn tcp option maxseg size set rt mtu counter comment "tcp mss clamping"

    ip6 saddr $lan_ipv6_prefix counter jump upstream_send
    ip saddr $lan_ipv4_prefix counter jump upstream_send

    counter reject
  }

  # zone: wan -> lan
  chain forward_wan_lan {
    # TODO: tighten this down
    meta l4proto { icmp, ipv6-icmp } counter jump upstream_recv

    counter drop
  }

  chain output {
    type filter hook output priority filter; policy accept;

    # stateless rules
    oifname "lo" accept
    oifname $wan_iface ip6 daddr $transix_endpoints ip6 nexthdr ipv4 accept

    # conntrack
    ct state { established, related } accept
    ct state invalid counter drop

    # zone based stateful rules
    oifname $zone_wan_ifaces counter jump output_wan
    oifname $zone_lan_ifaces counter jump output_lan

    counter reject
  }

  # zone: router -> wan
  chain output_wan {
    meta l4proto { icmp, ipv6-icmp } counter jump upstream_send

    tcp sport 32768-60999 tcp flags syn / fin,syn,rst,ack counter jump upstream_send
    udp sport 32768-60999 counter jump upstream_send
    ip6 nexthdr udp udp sport 546 udp dport 547 counter jump upstream_send comment "allow dhcpv6 to server"

    counter reject
  }

  # zone: router -> lan
  chain output_lan {
    meta l4proto { icmp, ipv6-icmp } counter accept

    tcp sport 32768-60999 tcp flags syn / fin,syn,rst,ack counter accept
    udp sport 32768-60999 counter accept

    counter accept
    # TODO: reject
  }

  chain upstream_send {
    oifname $wan_iface jump upstream_send_ipoe
    oifname $transix_iface jump upstream_send_dslite
    oifname $pppoe_iface jump upstream_send_pppoe

    counter log prefix "fw-drop-upstream-send: "
    drop
  }

  chain upstream_send_ipoe {
    # TODO: prevent bogon
    meta nfproto ipv6 accept
    return
  }

  chain upstream_send_dslite {
    # TODO: prevent bogon but allow private addresses
    meta nfproto ipv4 accept
    return
  }

  chain upstream_send_pppoe {
    # TODO: prevent bogon
    meta nfproto ipv4 accept
    return
  }

  chain upstream_recv {
    iifname $wan_iface jump upstream_recv_ipoe
    iifname $transix_iface jump upstream_recv_dslite
    iifname $pppoe_iface jump upstream_recv_pppoe

    counter log prefix "fw-drop-upstream-recv: "
    drop
  }

  chain upstream_recv_ipoe {
    # TODO: prevent bogon
    meta nfproto ipv6 accept
    return
  }

  chain upstream_recv_dslite {
    # TODO: prevent bogon but allow private addresses
    meta nfproto ipv4 accept
    return
  }

  chain upstream_recv_pppoe {
    # TODO: prevent bogon
    meta nfproto ipv4 accept
    return
  }
}

table inet raw {
  chain prerouting {
    type filter hook prerouting priority raw; policy accept;

    iifname "lo" notrack
    iifname $wan_iface ip6 saddr $transix_endpoints ip6 nexthdr ipv4 notrack
  }

  chain output {
    type filter hook output priority raw; policy accept;

    oifname "lo" notrack
    oifname $wan_iface ip6 daddr $transix_endpoints ip6 nexthdr ipv4 notrack
  }
}

table inet mangle {
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;

    iifname $pppoe_iface ct state new ct mark set $pppoe_ct_mark counter
  }

  chain output {
    type route hook output priority mangle; policy accept;

    ct mark $pppoe_ct_mark meta mark set ct mark counter
  }
}
